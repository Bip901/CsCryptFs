<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.2.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CsCryptFs.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="FileAbstractions" Version="0.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>CsCryptFs</Title>
    <Authors>Ori Almagor</Authors>
    <Description>A C# implementation of the gocryptfsfilesystem format.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Bip901/CsCryptFs</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Bip901/CsCryptFs</PackageProjectUrl>
    <RepositoryType>Git</RepositoryType>
    <PackageTags>gocryptfs filesystem cryptography</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DocumentationFile>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)/CsCryptFs.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>
